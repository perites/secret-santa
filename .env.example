# Copy this file to .env and fill in the values. .env is not committed.

# PIN for the /admin page. Admin login is disabled while it is empty.
ADMIN_PIN=change-me

# Optional: override the deadline from config.py (server local time).
# DEADLINE=2026-12-15T23:59:59

# Optional: override the gift budget from config.py (leave empty to hide it).
# GIFT_BUDGET=25-30 euro

# Optional: public address used in invite links, e.g. https://santa.example.com
# PUBLIC_URL=

# Optional: key for signing session cookies. If unset, a random key is
# generated once and stored in instance/secret_key.
# SECRET_KEY=

# Set to 1 when the site is served over HTTPS.
# SESSION_COOKIE_SECURE=1

# Settings for `python app.py`.
# HOST=127.0.0.1
# PORT=5003
# FLASK_DEBUG=1
